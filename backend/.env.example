# SCHEDULR IQ accounts. The values below are the DEVELOPMENT defaults used when these
# variables are unset. Always override them (and set SCHEDULR_SECRET) in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@iiits
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer@iiits
# Random 64-char hex string used to sign session tokens.
SCHEDULR_SECRET=
